# ==== Django ====
DJANGO_SECRET_KEY=            # obligatoria: generar con `python -c "import secrets; print(secrets.token_urlsafe(64))"`
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=allsafe.example.com
TIME_ZONE=America/Mexico_City

# HTTPS (con TLS en Nginx). En staging http-only poner SECURE_SSL_REDIRECT=false.
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=3600
CSRF_TRUSTED_ORIGINS=https://allsafe.example.com

# ==== Base de datos ====
DB_NAME=allsafe
DB_USER=allsafe
DB_PASSWORD=
DB_PORT=3306
MYSQL_ROOT_PASSWORD=

# ==== Email (opcional; sin EMAIL_HOST los mails van a consola) ====
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=AllSafe <no-reply@allsafe.example.com>

# ==== IA (wedge de IA) ====
# Encendé las features de IA (además gateadas por plan Pro/Business).
AI_FEATURES_ENABLED=false
# Proveedor de IA: anthropic (Claude) | gemini (Google) | openai (ChatGPT).
AI_PROVIDER=anthropic
# Hooks de IA fire-and-forget (triage, sentimiento, sugerencia de KB, ingesta
# omnicanal) fuera del request. true por defecto.
AI_ASYNC=true
# Backend de tareas async: "celery" usa la cola real (worker aparte, escala a
# multi-proceso); vacío = thread daemon in-process (dev/single-process).
AI_TASK_QUEUE=
# CELERY_BROKER_URL=redis://127.0.0.1:6379/0   # por defecto usa REDIS_URL
# Key SOLO del proveedor elegido (dejá vacías las otras). Ver backend/ai/README.md.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
# (Opcional) Override del modelo por proveedor/tier, p. ej.:
# AI_GEMINI_QUALITY_MODEL=gemini-2.5-pro
# AI_OPENAI_FAST_MODEL=gpt-5.1-nano
# (Opcional) Override de precios para el metering de costo (USD por 1M de tokens).
# Útil si tu tarifa difiere de la de referencia o para modelos sin precio cargado.
# AI_PRICE_OPENAI_GPT-5.1_IN=1.25
# AI_PRICE_OPENAI_GPT-5.1_OUT=10
# Los guardrails por org (opt-in, rate limits, presupuesto) se configuran por
# tenant vía API en /api/admin/ai/settings/, no por estas variables de entorno.

# ==== Omnicanal — WhatsApp (Cloud API de Meta; Fase 5.1) ====
# Config de despliegue por tenant en la consola de Meta. Sin esto, el webhook
# igual arranca (útil para email/otros canales); solo no procesa WhatsApp.
WHATSAPP_VERIFY_TOKEN=            # token que ponés en Meta para verificar el webhook
WHATSAPP_TOKEN=                  # access token del Graph API (para responder)
WHATSAPP_PHONE_NUMBER_ID=        # id del número emisor
WHATSAPP_APP_SECRET=             # para validar la firma X-Hub-Signature-256 (recomendado)
# WHATSAPP_API_BASE=https://graph.facebook.com/v21.0

# ==== Omnicanal — Email-to-ticket ====
# Secreto opcional para el webhook de email entrante (SendGrid/Mailgun/Postmark
# postean a /api/inbound/email/?token=<secreto>). La respuesta sale por EMAIL_HOST.
INBOUND_EMAIL_SECRET=

# ==== Omnicanal — Messenger / Instagram (Meta Graph) ====
# Webhook en /api/inbound/messenger/ (maneja Messenger de páginas e Instagram DM).
MESSENGER_VERIFY_TOKEN=          # token para verificar el webhook en Meta
MESSENGER_TOKEN=                 # page access token (para responder por la Send API)
MESSENGER_APP_SECRET=            # valida la firma X-Hub-Signature-256 (recomendado)
# MESSENGER_API_BASE=https://graph.facebook.com/v21.0
